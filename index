
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Roblox Script Copier</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 12px 23px;
    background: #0b0d12;
    color: #f1f3f9;
    font-family: Arial, sans-serif;
}

.container {
    max-width: 1000px;
    margin: auto;
}

h1 {
    font-size: 27px;
    margin: 0 0 8px;
}

.subtitle {
    color: #8d95a7;
    font-size: 14px;
    margin-bottom: 30px;
}

.script-card {
    background: #11141c;
    border: 1px solid #292e3c;
    border-radius: 12px;
    margin-bottom: 18px;
    overflow: hidden;
}

.card-header {
    min-height: 61px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid #292e3c;
}

.script-name {
    font-size: 14px;
    font-weight: 700;
}

.copy-button {
    background: #e9e8ff;
    color: #24204f;
    border: none;
    border-radius: 9px;
    padding: 10px 17px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
}

.copy-button:hover {
    background: #c9c5ff;
}

.copy-button:active {
    transform: scale(0.97);
}

.script-content {
    display: block;
    width: 100%;
    min-height: 155px;
    padding: 19px;
    background: transparent;
    color: #c8d2e4;
    border: none;
    outline: none;
    resize: vertical;
    font-family: Consolas, monospace;
    font-size: 13px;
    line-height: 1.7;
    white-space: pre;
    overflow: auto;
    cursor: text;
}

.footer {
    text-align: center;
    color: #687184;
    font-size: 12px;
    margin: 28px 0 10px;
}

@media (max-width: 520px) {
    body {
        padding: 20px 12px;
    }

    h1 {
        font-size: 23px;
    }
}
</style>
</head>

<body>
<div class="container">

    <h1>Roblox Script Copier</h1>
    <div class="subtitle">
        Your scripts, all in one place.
    </div>

    <main id="script-list"></main>

    <div class="footer">
        Maxweaea Scripts Copier
    </div>
</div>

<script>
// WEBSITE OWNER: Edit the names and scripts below.
// Visitors cannot add, rename, delete, or edit scripts here.

const scripts = [
    {
        name: "Xeioa HUB",
        code: `loadstring(game:HttpGet("https://raw.githubusercontent.com/ljjdwawdwd/StreetLifeMain/refs/heads/main/Slr.lua"))()`
    },
    {
        name: "Script 2",
        code: `-- Put your second Roblox script here`
    },
    {
        name: "Script 3",
        code: `-- Put your third Roblox script here`
    }
];

const list = document.getElementById("script-list");

scripts.forEach((script) => {
    const card = document.createElement("section");
    card.className = "script-card";

    const header = document.createElement("div");
    header.className = "card-header";

    const name = document.createElement("div");
    name.className = "script-name";
    name.textContent = script.name;

    const copy = document.createElement("button");
    copy.className = "copy-button";
    copy.textContent = "Copier";

    const content = document.createElement("textarea");
    content.className = "script-content";
    content.value = script.code;
    content.readOnly = true;
    content.spellcheck = false;
    content.setAttribute("aria-label", script.name);
    content.rows = 7;

    copy.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(script.code);
            copy.textContent = "Copié ✓";
        } catch {
            const temp = document.createElement("textarea");
            temp.value = script.code;
            temp.style.position = "fixed";
            temp.style.opacity = "0";
            document.body.appendChild(temp);
            temp.select();

            const success = document.execCommand("copy");
            temp.remove();

            copy.textContent = success
                ? "Copié ✓"
                : "Erreur";
        }

        setTimeout(() => {
            copy.textContent = "Copier";
        }, 1500);
    });

    header.append(name, copy);
    card.append(header, content);
    list.appendChild(card);
});
</script>
</body>
</html>
